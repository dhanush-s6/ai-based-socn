# Environment variables for LTE-AI SON System
# Copy this to .env and configure as needed

# Simulator Configuration
SIMULATOR_NUM_ENBS=6
SIMULATOR_NUM_UES=2000
SIMULATOR_TIME=1800
SIMULATOR_KPI_INTERVAL=1.0

# AI Server Configuration
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=5000
AI_WEBSOCKET_PORT=5001

# Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
DASHBOARD_DEBUG=false

# Model Configuration
MODEL_DIR=models/
HYBRID_MODEL_PATH=models/network_ai_hybrid.pkl

# Model Updater Configuration
MODEL_UPDATER_ENABLED=true
MODEL_UPDATER_INTERVAL=100
MIN_ACCURACY=0.75

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/simulation.log

# Data Paths
TRAINING_DATA_PATH=training_dataset.csv
KPI_DATA_PATH=/home/darkdevil/Desktop/project/lte-ai-project/data/city_kpi_dataset.csv
